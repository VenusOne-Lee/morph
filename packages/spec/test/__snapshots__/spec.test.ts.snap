exports[`view compiler (MO-205) > matches snapshots for every generated report > won-deals-by-month 1`] = `
"-- Report: Won value by month
create or replace view "public"."morph_r_won_deals_by_month" with (security_invoker = true) as
select
  "deals"."id"::text as "_morph_id",
  "deals"."xmin"::text as "_morph_version",
  "deals"."name" as "name",
  "deals"."stage" as "stage",
  "deals"."value_zar" as "value_zar",
  date_trunc('month', "deals"."closed_at")::date as "month"
from "public"."deals" as "deals"
where "deals"."stage" = 'won'
  and "deals"."closed_at" >= now() - make_interval(days => 183);
revoke all on "public"."morph_r_won_deals_by_month" from public, anon;
grant select on "public"."morph_r_won_deals_by_month" to authenticated;"
`;
