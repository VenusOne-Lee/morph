exports[`view compiler (MO-205) > matches snapshots for every generated report > idle-deals 1`] = `
"-- Report: Idle deals
create or replace view "public"."morph_r_idle_deals" with (security_invoker = true) as
select
  "deals"."id"::text as "_morph_id",
  "deals"."xmin"::text as "_morph_version",
  "deals"."name" as "name",
  "deals"."stage" as "stage",
  "users"."name" as "owner",
  "deals"."value_zar" as "value_zar",
  (current_date - "deals"."stage_changed_at"::date) as "days_in_stage",
  "deals"."owner_id" as "owner_id"
from "public"."deals" as "deals"
left join "public"."users" as "users" on "users"."id" = "deals"."owner_id"
where "deals"."stage" not in ('won', 'lost')
  and (current_date - "deals"."stage_changed_at"::date) > 30;
revoke all on "public"."morph_r_idle_deals" from public, anon;
grant select on "public"."morph_r_idle_deals" to authenticated;"
`;

