{
  "name": "morph-reports",
  "version": "0.1.0",
  "description": "Morph CLI: scan a Supabase project, generate reports and actions, and run the Morph MCP server.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "morph": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "locales"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run test/unit",
    "test:integration": "vitest run test/integration"
  },
  "dependencies": {
    "@morph-reports/spec": "workspace:*",
    "@morph-reports/sql": "workspace:*",
    "pg": "^8.13.1",
    "@morph-reports/mcp": "workspace:*"
  },
  "devDependencies": {
    "@morph-reports/testkit": "workspace:*",
    "@types/pg": "^8.11.10"
  }
}
