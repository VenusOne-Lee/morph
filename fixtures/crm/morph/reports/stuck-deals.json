{
  "$schema": "https://raw.githubusercontent.com/VenusOne-Lee/morph/main/packages/spec/schema/report.v0.json",
  "specVersion": 0,
  "id": "stuck-deals",
  "title": "Stuck deals",
  "why": "Open deals that haven't moved stage in over 14 days, oldest first.",
  "generatedBy": "stuck-records",
  "source": "deals",
  "fields": [
    "deals.name",
    "deals.stage",
    "users.name as owner",
    "deals.value_zar",
    "days_in_stage"
  ],
  "widgets": [
    {
      "title": "Stuck deals",
      "type": "kpi"
    },
    {
      "type": "table"
    },
    {
      "type": "queue",
      "view": "report",
      "options": {
        "threshold": 14
      }
    }
  ],
  "joins": [
    "deals.owner_id -> users.id"
  ],
  "derived": {
    "days_in_stage": {
      "days_since": "deals.stage_changed_at"
    }
  },
  "filters": [
    {
      "field": "deals.stage",
      "op": "not_in",
      "value": [
        "won",
        "lost"
      ]
    },
    {
      "field": "days_in_stage",
      "op": ">",
      "value": 14
    }
  ],
  "groupBy": [
    "deals.stage"
  ],
  "groupByOptions": [
    "owner"
  ],
  "measures": [
    {
      "fn": "count"
    },
    {
      "fn": "sum",
      "field": "deals.value_zar"
    }
  ],
  "sort": [
    {
      "field": "days_in_stage",
      "dir": "desc"
    }
  ],
  "actions": [
    "deals.owner_id",
    "deals.stage"
  ]
}
