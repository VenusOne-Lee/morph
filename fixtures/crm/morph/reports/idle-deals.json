{
  "$schema": "https://raw.githubusercontent.com/VenusOne-Lee/morph/main/packages/spec/schema/report.v0.json",
  "specVersion": 0,
  "id": "idle-deals",
  "title": "Idle deals",
  "why": "Open deals with no stage change in over 30 days, and the value at risk.",
  "generatedBy": "idle-records",
  "source": "deals",
  "fields": [
    "deals.name",
    "deals.stage",
    "users.name as owner",
    "deals.value_zar",
    "days_in_stage"
  ],
  "widgets": [
    {
      "type": "kpi-fix",
      "view": "report",
      "options": {
        "idleDays": 30
      }
    }
  ],
  "joins": [
    "deals.owner_id -> users.id"
  ],
  "derived": {
    "days_in_stage": {
      "days_since": "deals.stage_changed_at"
    }
  },
  "filters": [
    {
      "field": "deals.stage",
      "op": "not_in",
      "value": [
        "won",
        "lost"
      ]
    },
    {
      "field": "days_in_stage",
      "op": ">",
      "value": 30
    }
  ],
  "measures": [
    {
      "fn": "count"
    },
    {
      "fn": "sum",
      "field": "deals.value_zar"
    }
  ],
  "sort": [
    {
      "field": "days_in_stage",
      "dir": "desc"
    }
  ],
  "actions": [
    "deals.owner_id",
    "deals.stage"
  ]
}
