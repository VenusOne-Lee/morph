{
  "$schema": "https://raw.githubusercontent.com/VenusOne-Lee/morph/main/packages/spec/schema/report.v0.json",
  "specVersion": 0,
  "id": "stuck-tasks",
  "title": "Stuck tasks",
  "why": "Open tasks that haven't moved status in over 14 days, oldest first.",
  "generatedBy": "stuck-records",
  "source": "tasks",
  "fields": [
    "tasks.title",
    "tasks.status",
    "profiles.full_name as owner",
    "days_in_stage"
  ],
  "widgets": [
    {
      "title": "Stuck tasks",
      "type": "kpi"
    },
    {
      "type": "table"
    },
    {
      "type": "queue",
      "view": "report",
      "options": {
        "threshold": 14
      }
    }
  ],
  "joins": [
    "tasks.assignee_id -> profiles.id"
  ],
  "derived": {
    "days_in_stage": {
      "days_since": "tasks.status_changed_at"
    }
  },
  "filters": [
    {
      "field": "tasks.status",
      "op": "not_in",
      "value": [
        "done"
      ]
    },
    {
      "field": "days_in_stage",
      "op": ">",
      "value": 14
    }
  ],
  "groupBy": [
    "tasks.status"
  ],
  "groupByOptions": [
    "owner"
  ],
  "measures": [
    {
      "fn": "count"
    }
  ],
  "sort": [
    {
      "field": "days_in_stage",
      "dir": "desc"
    }
  ],
  "actions": [
    "tasks.status",
    "tasks.assignee_id"
  ]
}
