{
  "$schema": "https://raw.githubusercontent.com/VenusOne-Lee/morph/main/packages/spec/schema/report.v0.json",
  "specVersion": 0,
  "id": "stuck-projects",
  "title": "Stuck projects",
  "why": "Open projects that haven't moved status in over 14 days, oldest first.",
  "generatedBy": "stuck-records",
  "source": "projects",
  "fields": [
    "projects.name",
    "projects.status",
    "profiles.full_name as owner",
    "projects.budget",
    "days_in_stage"
  ],
  "widgets": [
    {
      "title": "Stuck projects",
      "type": "kpi"
    },
    {
      "type": "table"
    },
    {
      "type": "queue",
      "view": "report",
      "options": {
        "threshold": 14
      }
    }
  ],
  "joins": [
    "projects.owner_id -> profiles.id"
  ],
  "derived": {
    "days_in_stage": {
      "days_since": "projects.updated_at",
      "approximate": true
    }
  },
  "filters": [
    {
      "field": "projects.status",
      "op": "not_in",
      "value": [
        "done",
        "cancelled"
      ]
    },
    {
      "field": "days_in_stage",
      "op": ">",
      "value": 14
    }
  ],
  "groupBy": [
    "projects.status"
  ],
  "groupByOptions": [
    "owner"
  ],
  "measures": [
    {
      "fn": "count"
    },
    {
      "fn": "sum",
      "field": "projects.budget"
    }
  ],
  "sort": [
    {
      "field": "days_in_stage",
      "dir": "desc"
    }
  ],
  "actions": [
    "projects.status",
    "projects.owner_id"
  ]
}
